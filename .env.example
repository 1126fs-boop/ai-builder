# Supabase（Vercel では URL を明示設定するのが確実）
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 任意: Reference ID のみでも URL は自動生成されます
# NEXT_PUBLIC_SUPABASE_PROJECT_REF=your-project-ref

# 任意: Account → Access Tokens のトークン（setup:env が Reference ID を自動検出）
# SUPABASE_ACCESS_TOKEN=your-access-token

# ※ SUPABASE_SERVICE_ROLE_KEY は不要です

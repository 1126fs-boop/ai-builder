# Vercel 本番環境用（Settings → Environment Variables）
# 3 つすべて Production / Preview / Development に設定し、保存後 Redeploy してください。

# 方法 A: Project URL を直接指定（推奨・わかりやすい）
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# 方法 B: Reference ID のみ（URL は自動生成）
# NEXT_PUBLIC_SUPABASE_PROJECT_REF=your-project-ref
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# 本番アプリ URL（Supabase の Site URL と一致させる）
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
